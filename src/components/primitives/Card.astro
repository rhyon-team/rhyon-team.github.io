---
import { cn } from '../../lib/cn';

interface Props {
  /** Tag a renderizar. `li` para tarjetas dentro de una lista. */
  as?: 'div' | 'article' | 'li';
  class?: string;
}

const { as: Tag = 'div', class: className } = Astro.props;
---

<Tag class={cn('bg-surface-raised rounded-xl p-6 shadow-sm sm:p-8', className)}>
  <slot />
</Tag>
