---
import Section from '../primitives/Section.astro';
import Container from '../primitives/Container.astro';
import Heading from '../primitives/Heading.astro';
import Eyebrow from '../primitives/Eyebrow.astro';
import Card from '../primitives/Card.astro';

interface Servicio {
  titulo: string;
  descripcion: string;
  incluye: string[];
}

const servicios: Servicio[] = [
  {
    titulo: 'Software a medida',
    descripcion:
      'Desarrollamos sistemas, plataformas y aplicaciones adaptados a los procesos de cada organización. Incorporamos inteligencia artificial donde aporta eficiencia concreta.',
    incluye: [
      'Relevamiento de procesos y requerimientos',
      'Diseño y desarrollo a medida',
      'Integración con los sistemas existentes',
      'Soporte y mantenimiento evolutivo',
    ],
  },
  {
    titulo: 'Integración y automatización',
    descripcion:
      'Conectamos las herramientas de la organización, como CRM, mensajería y gestión, para que la información circule sin tareas manuales.',
    incluye: [
      'Integración entre plataformas y APIs',
      'Automatización de procesos repetitivos',
      'Sincronización de datos entre sistemas',
      'Automatizaciones con IA cuando corresponde',
    ],
  },
  {
    titulo: 'Primera versión',
    descripcion:
      'Llevamos una idea a una primera versión funcional para validarla con usuarios reales antes de invertir en el producto completo.',
    incluye: [
      'Definición del alcance esencial',
      'Prototipo funcional en plazos acotados',
      'Pruebas con usuarios reales',
      'Plan de evolución según los resultados',
    ],
  },
];
---

<Section id="servicios" tone="sunken">
  <Container>
    <Eyebrow>Servicios</Eyebrow>
    <Heading as="h2" class="mt-4">
      Qué hacemos
    </Heading>
    {/* Con subgrid, las tres tarjetas comparten filas: titulo, descripcion e
        "Incluye" quedan alineados aunque los textos tengan largos distintos. */}
    <ul class="mt-12 grid gap-6 md:grid-cols-3 md:gap-y-0">
      {servicios.map((servicio) => (
        <Card as="li" class="flex flex-col md:row-span-3 md:grid md:grid-rows-subgrid">
          <h3 class="text-xl">{servicio.titulo}</h3>
          <p class="text-content-muted mt-3 mb-6">{servicio.descripcion}</p>
          <div class="border-line border-t pt-6">
            <p class="text-content text-sm font-medium">Incluye</p>
            <ul class="text-content-muted mt-3 space-y-2 text-sm">
              {servicio.incluye.map((item) => (
                <li class="flex gap-2">
                  <span class="text-accent" aria-hidden="true">
                    —
                  </span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </Card>
      ))}
    </ul>
  </Container>
</Section>
