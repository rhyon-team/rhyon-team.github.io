---
import Section from '../primitives/Section.astro';
import Container from '../primitives/Container.astro';
import Heading from '../primitives/Heading.astro';
import Eyebrow from '../primitives/Eyebrow.astro';
---

<Section id="producto" tone="sunken">
  <Container>
    <Eyebrow>Producto propio · Próximamente</Eyebrow>
    <Heading as="h2" class="mt-4">
      También construimos lo nuestro.
    </Heading>
    <p class="text-content-muted mt-6 max-w-xl text-lg">
      Estamos trabajando en un producto propio. Pronto vas a poder conocerlo.
    </p>
  </Container>
</Section>
