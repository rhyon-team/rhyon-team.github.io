---
import Section from '../primitives/Section.astro';
import Container from '../primitives/Container.astro';
import Heading from '../primitives/Heading.astro';
import Eyebrow from '../primitives/Eyebrow.astro';
import Card from '../primitives/Card.astro';

interface Proyecto {
  titulo: string;
  cliente: string;
  descripcion: string;
  funcionalidades: string[];
}

// La descripcion del CRM es provisoria hasta revisarla con el cliente: ver
// docs/placeholders.md.
const proyectos: Proyecto[] = [
  {
    titulo: 'CRM inmobiliario',
    cliente: 'Inmobiliaria UrbanRise',
    descripcion:
      'Sistema de gestión de clientes que centraliza las consultas, ordena el seguimiento de cada interesado y reúne el historial de cada operación en un solo lugar.',
    funcionalidades: [
      'Registro centralizado de contactos y consultas',
      'Seguimiento de oportunidades por etapa',
      'Historial completo de cada operación',
    ],
  },
];
---

<Section id="proyectos">
  <Container>
    <Eyebrow>Proyectos</Eyebrow>
    <Heading as="h2" class="mt-4">
      Proyectos recientes
    </Heading>
    <ul class="mt-12 grid gap-6">
      {proyectos.map((proyecto) => (
        <Card as="li" class="grid gap-8 md:grid-cols-2 md:gap-12">
          <div>
            <p class="text-accent text-sm font-medium">{proyecto.cliente}</p>
            <h3 class="mt-2 text-2xl">{proyecto.titulo}</h3>
            <p class="text-content-muted mt-4">{proyecto.descripcion}</p>
          </div>
          <div>
            <p class="text-content text-sm font-medium">Funcionalidades</p>
            <ul class="text-content-muted mt-3 space-y-2 text-sm">
              {proyecto.funcionalidades.map((funcionalidad) => (
                <li class="flex gap-2">
                  <span class="text-accent" aria-hidden="true">
                    —
                  </span>
                  {funcionalidad}
                </li>
              ))}
            </ul>
          </div>
        </Card>
      ))}
    </ul>
  </Container>
</Section>
