---
import Container from '../primitives/Container.astro';
import MobileNav from './MobileNav.tsx';
import { navigation, site } from '../../lib/site';
---

<header class="bg-surface/85 border-line sticky top-0 z-50 border-b backdrop-blur-md">
  <Container size="wide" class="flex h-16 items-center justify-between">
    <a
      href="/"
      class="font-display text-accent text-xl font-semibold tracking-tight"
      aria-label={`${site.name} — inicio`}
    >
      {site.name}
    </a>

    {navigation.length > 0 && (
      <nav class="hidden md:block" aria-label="Navegacion principal">
        <ul class="flex items-center gap-8">
          {navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-content-muted hover:text-accent text-sm transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div class="md:hidden">
      <MobileNav items={navigation} client:media="(max-width: 767px)" />
    </div>
  </Container>
</header>
